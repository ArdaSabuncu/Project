class CountryMap {
    public static final int MAX_POINTS = 100;
    private City[] cities = new City[MAX_POINTS]; 
    private int[][] graph = new int[MAX_POINTS][MAX_POINTS];  
    private int cityCount = 0; 
    // Method to add a city and return its index//
    public int addCity(String cityName) {
        for (int i = 0; i < cityCount; i++) {
            if (cities[i].getName().equals(cityName)) {
                return i;  
            }
        }
        if (cityCount < MAX_POINTS) {
            cities[cityCount] = new City(cityName, cityCount);
            return cityCount++;
        } else {
            System.err.println("Maximum number of cities reached.");
            return -1;  // Error if max cities reached
        }
    }

    
    public void addRoad(String startCity, String endCity, int weight) {
        int startIndex = addCity(startCity);
        int endIndex = addCity(endCity);

        if (startIndex != -1 && endIndex != -1) {
            graph[startIndex][endIndex] = weight;
            graph[endIndex][startIndex] = weight;  
        }
    }

   
    public int getCityCount() {
        return cityCount;
    }

    
    public City getCityByIndex(int index) {
        if (index >= 0 && index < cityCount) {
            return cities[index];
        }
        return null;
    }

    
    public City getCityByName(String name) {
        for (int i = 0; i < cityCount; i++) {
            if (cities[i].getName().equals(name)) {
                return cities[i];
            }
        }
        return null;
    }

  
    public int getRoadWeight(int startIndex, int endIndex) {
        return graph[startIndex][endIndex];
    }
}





