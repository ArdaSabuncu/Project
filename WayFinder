import java.io.FileWriter;
import java.io.IOException;
import java.util.Arrays;

class WayFinder {
    private CountryMap map;
    private boolean[] visited;
    private String shortestPath;
    private int shortestDistance;

    // Constructor updated to accept only CountryMap parameter
    public WayFinder(CountryMap map){
        this.map=map;
        this.visited = new boolean[CountryMap.MAX_POINTS];
        this.shortestPath ="";
        this.shortestDistance = Integer.MAX_VALUE;

    }

    // Method to find the shortest path and write it to the file
    public void findShortestPath(String startCity,String endCity,FileWriter fileWriter){
        Arrays.fill(visited,false); // Reset the visited array
        findPaths(startCity,endCity,"",0);

        try {
            if(shortestDistance != Integer.MAX_VALUE){
                fileWriter.write("Fastest way: " + shortestPath +"\n");
                fileWriter.write("Total Time: " + shortestDistance +" min "+"\n");
            }else{
                fileWriter.write("No path found.\n");
            }
        } catch (IOException e) {
            System.err.println("Error writing to file:"+ e.getMessage());

        }
    }

    // Find the shortest path
    private void findPaths(String current,String destination,String path,int currentDistance){
        path += current +" -> ";

        City currentCity = map.getCityByName(current);
        if (currentCity == null) return; // If the city is not found, return

        int currentIndex = currentCity.getIndex();
        visited[currentIndex] = true; // Mark the city as visited

        // If the destination is reached, check if it's the shortest path
        if(current.equals(destination)){
            if(currentDistance < shortestDistance){
                shortestDistance = currentDistance;
                shortestPath = path.substring(0,path.length() - 4); // remove the last " -> "

            }
        }else{
            for(int i = 0; i < map.getCityCount();i++){
                if(map.getRoadWeight(currentIndex, i) !=0 && !visited[i]){
                    findPaths(map.getCityByIndex(i).getName(),destination,path,currentDistance + map.getRoadWeight(currentIndex,i));

                }
            }
        }
        visited[currentIndex] = false; // Unmark the city to make it available for other paths
    }
}
